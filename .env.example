# Shared B2 credentials and region
B2_APPLICATION_KEY_ID="<your B2 application key ID>"
B2_APPLICATION_KEY="<your B2 application key>"
B2_REGION="<for example: us-west-001>"

# Public/static bucket used by the web application
B2_BUCKET_NAME="<your public B2 bucket name>"
B2_PUBLIC_URL_BASE="<for example: https://f001.backblazeb2.com/file/your-public-bucket>"

# Private media bucket used by the web application and worker
B2_PRIVATE_BUCKET_NAME="<your private B2 bucket name>"

# Web application callback endpoint for the worker
TRANSCODER_WEBHOOK="<the API endpoint for the transcoder worker, e.g. http://1.2.3.4:5678/videos>"
